<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.gerenciamentos_de_viagens"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="36" />

    <permission
        android:name="com.example.gerenciamentos_de_viagens.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.example.gerenciamentos_de_viagens.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:testOnly="true"
        android:theme="@style/Theme.Gerenciamentos_de_viagens" >
        <activity
            android:name="com.example.gerenciamentos_de_viagens.MainActivity"
            android:exported="true"
            android:label="Configurar viagem" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.example.gerenciamentos_de_viagens.ActivitiesListActivity"
            android:exported="false"
            android:label="Atividades sugeridas"
            android:parentActivityName="com.example.gerenciamentos_de_viagens.MainActivity" />
        <activity
            android:name="com.example.gerenciamentos_de_viagens.ActivityDetailActivity"
            android:exported="false"
            android:label="Detalhes da atividade"
            android:parentActivityName="com.example.gerenciamentos_de_viagens.ActivitiesListActivity" />
        <activity
            android:name="com.example.gerenciamentos_de_viagens.SummaryActivity"
            android:exported="false"
            android:label="Resumo da viagem"
            android:parentActivityName="com.example.gerenciamentos_de_viagens.ActivityDetailActivity" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.example.gerenciamentos_de_viagens.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>